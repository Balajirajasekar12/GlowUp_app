# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to git.

# --- Supabase (free project at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Replicate) ---
# Sign up free at https://replicate.com — you only pay per call, no fixed
# cost. Leave REPLICATE_API_TOKEN blank to keep using the built-in mock
# responses (free, no key needed, but not real AI output).
REPLICATE_API_TOKEN=

# Model "version" hashes — find these on each model's page on
# https://replicate.com/explore, e.g.:
#   Vision analysis: a Qwen2.5-VL model
#   Image edit (skin/hair style change): a Qwen-Image-Edit model
#   Virtual try-on (outfits): an IDM-VTON / OOTDiffusion-style model
REPLICATE_VLM_VERSION=
REPLICATE_IMAGE_EDIT_VERSION=
REPLICATE_TRYON_VERSION=

# --- Age / identity verification (required before enabling public gallery in production) ---
# e.g. Stripe Identity, Persona, Veriff. Leave blank in local dev.
AGE_VERIFICATION_API_KEY=
